<%# Form fields shared by the Add page and the Edit page. Needs: f (current values) %>
<input type="hidden" name="isbn" id="isbn" value="<%= f.isbn || '' %>" />
<input type="hidden" name="cover_id" id="cover_id" value="<%= f.cover_id || '' %>" />

<label for="title">Title *</label>
<input type="text" name="title" id="title" value="<%= f.title || '' %>" required />

<div class="two-col">
  <div>
    <label for="author">Author</label>
    <input type="text" name="author" id="author" value="<%= f.author || '' %>" />
  </div>
  <div>
    <label for="first_publish_year">First published (year)</label>
    <input type="number" name="first_publish_year" id="first_publish_year" value="<%= f.first_publish_year || '' %>" />
  </div>
</div>

<div class="two-col">
  <div>
    <label for="rating">My rating *</label>
    <select name="rating" id="rating" required>
      <% for (let i = 5; i >= 1; i--) { %>
        <option value="<%= i %>" <%= String(f.rating || 5) === String(i) ? "selected" : "" %>><%= stars(i) %>  (<%= i %>)</option>
      <% } %>
    </select>
  </div>
  <div>
    <label for="date_read">Date read *</label>
    <input type="date" name="date_read" id="date_read" value="<%= inputDate(f.date_read || new Date()) %>" required />
  </div>
</div>

<label for="summary">Short summary (shown on the front page)</label>
<input type="text" name="summary" id="summary" maxlength="300" value="<%= f.summary || '' %>" />

<label for="notes">My notes (shown on the book page)</label>
<textarea name="notes" id="notes" rows="9"><%= f.notes || '' %></textarea>
